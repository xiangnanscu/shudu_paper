{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shudu-paper",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shudu_paper_db",
      "database_id": "d93fa029-ff0a-4b26-93df-4e344db131e2"
    }
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "shudu-paper.toreal.site",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
