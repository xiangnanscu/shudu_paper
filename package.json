{
  "name": "shudu-paper",
  "version": "1.0.0",
  "description": "四宫格数独试卷生成与在线答题系统",
  "main": "src/index.ts",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "dev:worker": "wrangler dev",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-classes": "node scripts/generate-classes.js",
    "build:frontend": "node scripts/generate-icons.js && vite build --config frontend/vite.config.ts",
    "build": "npm run build:frontend",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^2.0.0",
    "vue-tsc": "^2.1.10",
    "wrangler": "^4.42.0"
  }
}
